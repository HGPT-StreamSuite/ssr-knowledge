{
  "format": "ssr.knowledge.interfaces.v1",
  "producer": "ssr-knowledge/0.1.0",
  "responsibility": "Independent offline preparation and PEAK catalog; no chat/LLM, no identity inference, no complete shared-Record export",
  "cli_commands": [
    "acceptance-native",
    "catalog",
    "prebuild",
    "publish",
    "query",
    "research",
    "review",
    "supplement",
    "tools"
  ],
  "catalog_actions": [
    "badge-drafts",
    "collect",
    "discover-details",
    "entry",
    "events",
    "export-source-plan",
    "extract-game-names",
    "game-plan-status",
    "import-drafts",
    "import-game-text",
    "import-name-reference",
    "import-text-source",
    "import-web-excerpt",
    "ingest-collection",
    "match-community-names",
    "pair-game-names",
    "parse-peak-items",
    "publish-entry",
    "register-file-source",
    "register-game-plan",
    "register-sources",
    "relations",
    "render-review",
    "research-batch",
    "review-entry",
    "search",
    "serve-review",
    "snapshot",
    "snapshot-diff",
    "source-status",
    "sources",
    "stats"
  ],
  "native": {
    "entry": [
      "python",
      "-B",
      "-X",
      "utf8",
      "-m",
      "ssr_knowledge",
      "acceptance-native"
    ],
    "library": [
      "ssr_knowledge.acceptance_native.handle_request",
      "ssr_knowledge.acceptance_native.handle_json"
    ],
    "request_format": "ssr.knowledge.acceptance.request.v1",
    "response_format": "ssr.knowledge.acceptance.response.v1",
    "operations": [
      "catalog_check",
      "gap_supplement_preview",
      "prebuild_preview",
      "validate"
    ],
    "exit_codes": {
      "0": "processed; inspect native data status",
      "1": "rejected/native error",
      "2": "argparse rejects unsupported CLI arguments; stderr, no response envelope"
    },
    "max_utf8_bytes": 65536,
    "web_transport_connected": false
  },
  "legacy_outputs": {
    "prebuild": "contracts/candidate.schema.json",
    "research": "contracts/research-packet.schema.json",
    "publish": "contracts/published-bundle.schema.json",
    "errors": {
      "exit_1": {
        "status": "error",
        "error": "diagnostic string"
      },
      "exit_2": "argparse usage on stderr; not a JSON envelope"
    },
    "catalog_search": [
      "scope",
      "query",
      "status",
      "matches",
      "total_matches",
      "truncated",
      "name_resolution",
      "names_only"
    ],
    "catalog_match": [
      "revision_id",
      "status",
      "stale",
      "entry",
      "sources",
      "payload_sha256",
      "match_type"
    ]
  },
  "upstream": {
    "provider": "ssr-collector-peak",
    "protocols": [
      "ssr.source-plan.v1",
      "ssr.collection.v1",
      "ssr.game-plan.v1"
    ],
    "binding": "exact source_id/config_sha256/URL/raw/body hashes; no permission grant in bundle"
  },
  "downstream": {
    "consumer": "ssr-chat/CatalogKnowledgeReader",
    "entry": "catalog search --text=NAME --names-only --limit 2",
    "required_permission": "snapshot_usage.ai_input and current_usage.ai_input both allowed; search_index alone insufficient",
    "synthetic_receipt_ai_input": "unknown; not allowed for model input"
  },
  "shared_record_bridge": {
    "connected": false,
    "consumer": "hgpt-game-store / hgpt-ssr-game-search 1.0.1",
    "missing_authoritative_fields": [
      "schema_version",
      "source_event_id",
      "event_time",
      "received_at",
      "scope",
      "actor_account_id",
      "record_kind",
      "quality_flags",
      "source_refs",
      "access_scope"
    ],
    "rule": "Do not rename Evidence/catalog entry into a full Record or infer source ACL/scope/version. Coordinator decision required."
  },
