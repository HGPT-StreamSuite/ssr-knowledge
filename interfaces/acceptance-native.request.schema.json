            "source"
          ],
          "properties": {
            "source": {
              "$schema": "https://json-schema.org/draft/2020-12/schema",
              "title": "Prebuild source bundle",
              "type": "object",
              "required": [
                "bundle_id",
                "records"
              ],
              "properties": {
                "bundle_id": {
                  "type": "string"
                },
                "records": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "record_id",
                      "kind",
                      "topic",
                      "summary",
                      "tags",
                      "source"
                    ],
                    "properties": {
                      "record_id": {
                        "type": "string"
                      },
                      "kind": {
                        "type": "string",
                        "enum": [
                          "person",
                          "game_info",
                          "game_guide",
                          "game_item"
                        ]
                      },
                      "topic": {
                        "type": "string"
                      },
                      "summary": {
                        "type": "string"
                      },
                      "tags": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      },
                      "source": {
                        "type": "object",
                        "required": [
                          "source_id",
                          "source_type",
                          "title",
                          "locator",
                          "accessed_at"
                        ],
                        "properties": {
                          "source_id": {
                            "type": "string"
                          },
                          "source_type": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          },
                          "locator": {
                            "type": "string"
                          },
                          "accessed_at": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      }
                    },
                    "additionalProperties": false
                  }
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": [
        "format",
        "operation",
        "input"
      ],
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "ssr.knowledge.acceptance.request.v1"
          ]
        },
        "operation": {
          "type": "string",
          "enum": [
            "validate"
          ]
        },
        "input": {
          "type": "object",
          "required": [
            "schema",
            "value"
          ],
          "properties": {
            "schema": {
              "type": "string",
              "enum": [
                "candidate.schema.json",
                "gap-export.schema.json",
                "prebuild-source.schema.json",
                "published-bundle.schema.json",
                "record.schema.json",
                "research-packet.schema.json",
                "supplement-records.schema.json",
                "tool-config.schema.json"
              ]
            },
            "value": {}
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  ],
  "x-native-profile": {
    "max_utf8_bytes": 65536,
    "max_depth": 32,
    "max_nodes": 5000,
    "synthetic_records": "1..10; fixture- ID, fictional source_type, fixture:// locator; further native nonempty/referential checks apply",
    "query": "nonblank 1..200 Unicode characters",
    "strict_json": "reject nonfinite constants"
  }
}
